---
import Section from "./Section.astro";
import type { CoreCompetenciesProps } from "@types";
interface Props {
  corecompetencies: CoreCompetenciesProps[];
}

const { corecompetencies } = Astro.props;
---

<Section text="Core Competencies" href="skills">
  {
    corecompetencies.map(({ cc }) => (
  <ul class="[relative group m-1 inline-block rounded-full bg-neutral px-8 py-4 text-sm leading-3 font-medium text-white hover:bg-primary">
    <li>{cc}</li>
  </ul>
  ))
}