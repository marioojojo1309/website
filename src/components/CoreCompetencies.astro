---
import Section from "./Section.astro";
import type { CoreCompetenciesProps } from "@types";
interface Props {
  corecompetencies: CoreCompetenciesProps[];
}

const { corecompetencies } = Astro.props;
---

<Section text="Core Competencies" href="corecompetencies">
  {
    corecompetencies.map(({ cc }) => (
  <ul class="[relative group m-1 cursor-default inline-block rounded-full bg-neutral px-8 py-4 text-sm leading-3 font-medium text-white transition-shadow duration-400 ease-in-out hover:bg-primary hover:shadow-lg hover:shadow-primary/50">
    <li>{cc}</li>
  </ul>
  ))
}