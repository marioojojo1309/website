---
import Section from "./Section.astro";
import type { SelectedAchievementsProps } from "@types";
interface Props {
  selectedachievements: SelectedAchievementsProps[];
}

const { selectedachievements } = Astro.props;
---

<Section text="Selected Achievements" href="selectedachievements">
  {
    selectedachievements.map(({ achievement }) => (
      <p class="text-base text-neutral">
        <p class="relative mb-3 pl-8 text-base text-neutral before:absolute before:top-1 before:left-0 before:content-[url(/check.svg)]">
          <Fragment set:html={achievement} />
        </p>
      </p>
    ))
  }</Section
>
