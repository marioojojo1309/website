---
import Section from "./Section.astro";
import type { SkillProps } from "@types";
interface Props {
  skills: SkillProps[];
}

const { skills } = Astro.props;
---

<Section text="Skills" href="skills">
  {
    skills.map(({ skill }) => (
  <ul class="m-1 inline-block rounded-full bg-neutral px-8 py-4 text-sm leading-5 font-medium text-[#fff]">
    <li>{skill}</li>
  </ul>
  ))
}